# ==========================================
# MITRENO GO BACKEND CONFIGURATION
# ==========================================

# Server Config
PORT=8080
ENV=development
API_BASE_URL=http://localhost:8080

# PostgreSQL / Supabase Connection
# Example: postgres://postgres:password@db.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgres://postgres:password@localhost:5432/mitreno?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# Firebase Admin SDK (for Phone OTP UID verification & FCM Push Notifications)
FIREBASE_PROJECT_ID=mitreno-production
FIREBASE_CREDENTIALS_JSON=

# Cloudflare R2 (S3 Compatible Storage for Reels & Images)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=mitreno-media
CLOUDFLARE_R2_PUBLIC_URL=https://media.mitreno.com

# Admin Security Key
ADMIN_SECRET_KEY=mitreno_super_secret_admin_key_2026
